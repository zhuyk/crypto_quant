# CryptoQuant 环境配置示例
# 复制此文件为 .env 并修改相应配置

# ============================================
# 基础配置
# ============================================
ENVIRONMENT=development
DEBUG=True
SECRET_KEY=your-super-secret-key-change-this-in-production

# ============================================
# 数据库配置
# ============================================
DB_ROOT_PASSWORD=cryptoquant2026
DB_USER=cryptoquant
DB_PASSWORD=cryptoquant2026
DATABASE_URL=mysql://cryptoquant:cryptoquant2026@localhost:3306/crypto_quant

# ============================================
# Redis 配置
# ============================================
REDIS_URL=redis://localhost:6379

# ============================================
# Binance 配置
# ============================================
# 测试网 API (用于开发测试)
BINANCE_TESTNET=True
BINANCE_API_KEY=your-testnet-api-key
BINANCE_API_SECRET=your-testnet-api-secret

# 生产环境 API (实盘时使用)
# BINANCE_TESTNET=False
# BINANCE_API_KEY=your-production-api-key
# BINANCE_API_SECRET=your-production-api-secret

# ============================================
# CORS 配置
# ============================================
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# ============================================
# 日志配置
# ============================================
LOG_LEVEL=INFO
LOG_FILE=logs/cryptoquant.log

# ============================================
# 交易配置
# ============================================
DEFAULT_INITIAL_CAPITAL=100000
MAX_POSITION_RATIO=0.8
MAX_DAILY_LOSS=0.05
MAX_DRAWDOWN=0.20
