# ============================================
# CryptoQuant 生产环境配置
# ============================================
# ⚠️ 敏感信息请通过环境变量或密钥管理服务注入
# ⚠️ 不要将此文件提交到版本控制
# ============================================

# 基础配置
ENVIRONMENT=production
DEBUG=False
SECRET_KEY=${SECRET_KEY}  # 必须通过环境变量注入

# 数据库配置 (生产 MySQL 集群)
DB_HOST=${DB_HOST}
DB_PORT=3306
DB_ROOT_PASSWORD=${DB_ROOT_PASSWORD}
DB_USER=cryptoquant_prod
DB_PASSWORD=${DB_PASSWORD}
DATABASE_URL=mysql://cryptoquant_prod:${DB_PASSWORD}@${DB_HOST}:3306/crypto_quant_prod

# 数据库连接池
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=3600

# Redis 配置 (生产集群)
REDIS_HOST=${REDIS_HOST}
REDIS_PORT=6379
REDIS_PASSWORD=${REDIS_PASSWORD}
REDIS_URL=redis://:${REDIS_PASSWORD}@${REDIS_HOST}:6379/0

# Binance 配置 (生产环境 - 实盘)
BINANCE_TESTNET=False
BINANCE_API_KEY=${BINANCE_API_KEY}
BINANCE_API_SECRET=${BINANCE_API_SECRET}
BINANCE_BASE_URL=https://api.binance.com

# 订单执行配置
ORDER_TIMEOUT=30000
ORDER_RETRY_COUNT=3
SLIPPAGE_TOLERANCE=0.001
MAX_ORDER_SIZE_RATIO=0.1

# API 服务配置
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_WORKERS=4
FRONTEND_PORT=3000

# CORS 配置 (生产域名)
CORS_ORIGINS=https://cryptoquant.example.com,https://api.cryptoquant.example.com

# 日志配置
LOG_LEVEL=WARNING
LOG_FILE=/var/log/cryptoquant/production.log
LOG_FORMAT=json
LOG_ROTATION=daily
LOG_RETENTION_DAYS=30

# 交易配置 (严格风控)
DEFAULT_INITIAL_CAPITAL=100000
MAX_POSITION_RATIO=0.3
MAX_DAILY_LOSS=0.02
MAX_DRAWDOWN=0.08
EMERGENCY_STOP_ENABLED=True

# Celery 配置
CELERY_BROKER_URL=redis://:${REDIS_PASSWORD}@${REDIS_HOST}:6379/1
CELERY_RESULT_BACKEND=redis://:${REDIS_PASSWORD}@${REDIS_HOST}:6379/2
CELERY_WORKER_CONCURRENCY=4
CELERY_TASK_TIME_LIMIT=300

# 监控配置
PROMETHEUS_ENABLED=True
GRAFANA_ENABLED=True
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001

# 告警配置
DINGTALK_WEBHOOK=${DINGTALK_WEBHOOK}
DINGTALK_SECRET=${DINGTALK_SECRET}
EMAIL_SMTP_SERVER=smtp.example.com
EMAIL_SMTP_PORT=587
EMAIL_FROM=alerts@cryptoquant.example.com
EMAIL_TO=admin@cryptoquant.example.com

# 安全配置
RATE_LIMIT_ENABLED=True
RATE_LIMIT_PER_MINUTE=60
API_KEY_ROTATION_DAYS=30
SESSION_TIMEOUT_MINUTES=60

# 备份配置
BACKUP_ENABLED=True
BACKUP_INTERVAL_HOURS=6
BACKUP_RETENTION_DAYS=7
BACKUP_S3_BUCKET=cryptoquant-backups
BACKUP_S3_REGION=ap-southeast-1
