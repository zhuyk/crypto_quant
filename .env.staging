# ============================================
# CryptoQuant 预发布环境配置
# ============================================
# 用于 staging 环境测试，接近生产配置
# ============================================

# 基础配置
ENVIRONMENT=staging
DEBUG=False
SECRET_KEY=staging-secret-key-change-this

# 数据库配置 (远程 MySQL)
DB_HOST=staging-db.example.com
DB_PORT=3306
DB_ROOT_PASSWORD=${DB_ROOT_PASSWORD}
DB_USER=cryptoquant_staging
DB_PASSWORD=${DB_PASSWORD}
DATABASE_URL=mysql://cryptoquant_staging:${DB_PASSWORD}@staging-db.example.com:3306/crypto_quant_staging

# Redis 配置
REDIS_HOST=staging-redis.example.com
REDIS_PORT=6379
REDIS_URL=redis://staging-redis.example.com:6379/0

# Binance 配置 (测试网或小资金实盘)
BINANCE_TESTNET=True
BINANCE_API_KEY=${BINANCE_API_KEY}
BINANCE_API_SECRET=${BINANCE_API_SECRET}
BINANCE_BASE_URL=https://testnet.binance.vision

# API 服务配置
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_PORT=3000

# CORS 配置
CORS_ORIGINS=https://staging.example.com,https://staging-api.example.com

# 日志配置
LOG_LEVEL=INFO
LOG_FILE=/var/log/cryptoquant/staging.log
LOG_FORMAT=json

# 交易配置
DEFAULT_INITIAL_CAPITAL=50000
MAX_POSITION_RATIO=0.5
MAX_DAILY_LOSS=0.03
MAX_DRAWDOWN=0.10

# Celery 配置
CELERY_BROKER_URL=redis://staging-redis.example.com:6379/1
CELERY_RESULT_BACKEND=redis://staging-redis.example.com:6379/2

# 监控配置
PROMETHEUS_ENABLED=True
GRAFANA_ENABLED=True
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001

# 告警配置
DINGTALK_WEBHOOK=${DINGTALK_WEBHOOK}
EMAIL_SMTP_SERVER=smtp.example.com
EMAIL_SMTP_PORT=587
EMAIL_FROM=noreply@example.com
