# ============================================
# CryptoQuant 开发环境配置
# ============================================
# 用于本地开发和测试
# ============================================

# 基础配置
ENVIRONMENT=development
DEBUG=True
SECRET_KEY=dev-secret-key-not-for-production

# 数据库配置 (本地 Docker MySQL)
DB_HOST=localhost
DB_PORT=3307
DB_ROOT_PASSWORD=cryptoquant2026
DB_USER=cryptoquant_dev
DB_PASSWORD=cryptoquant_dev_2026
DATABASE_URL=mysql://cryptoquant_dev:cryptoquant_dev_2026@localhost:3307/crypto_quant_dev

# Redis 配置
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# Binance 配置 (测试网)
BINANCE_TESTNET=True
BINANCE_API_KEY=your-testnet-api-key
BINANCE_API_SECRET=your-testnet-api-secret
BINANCE_BASE_URL=https://testnet.binance.vision

# API 服务配置
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_PORT=3000

# CORS 配置
CORS_ORIGINS=http://localhost:3000,http://localhost:8080,http://127.0.0.1:3000

# 日志配置
LOG_LEVEL=DEBUG
LOG_FILE=logs/dev.log
LOG_FORMAT=detailed

# 交易配置 (测试用)
DEFAULT_INITIAL_CAPITAL=100000
MAX_POSITION_RATIO=0.8
MAX_DAILY_LOSS=0.05
MAX_DRAWDOWN=0.20

# Celery 配置
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# 监控配置 (开发环境关闭)
PROMETHEUS_ENABLED=False
GRAFANA_ENABLED=False
